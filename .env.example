# Public app metadata
VITE_APP_NAME=React CRUD Template

# Database
DATABASE_URL=postgresql://username:password@your-neon-host/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-32-char-secret
BETTER_AUTH_URL=http://localhost:5173

# Optional social providers
# Leave AUTH_SOCIAL_PROVIDERS empty to enable any provider with matching credentials.
# Or set a comma-separated allowlist such as: github,discord
AUTH_SOCIAL_PROVIDERS=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
